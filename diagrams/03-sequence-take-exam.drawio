        <mxCell id="a4" edge="1" parent="1" source="svc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" target="db" value="Lấy câu hỏi, ẩn đáp án đúng">
          <mxGeometry relative="1" as="geometry" />
