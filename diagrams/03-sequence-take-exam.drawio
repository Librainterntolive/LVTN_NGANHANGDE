        </mxCell>
        <mxCell id="a1" edge="1" parent="1" source="s" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" target="fe" value="Chọn đề">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" parent="1" source="fe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block" target="ctl" value="GET /exams/{id}/take">
