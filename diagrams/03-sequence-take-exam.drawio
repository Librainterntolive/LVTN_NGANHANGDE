<mxfile host="Electron" agent="Codex">
  <diagram id="sequence-take-exam" name="Sequence - Làm bài">
    <mxGraphModel dx="1398" dy="825" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center" value="SƠ ĐỒ TUẦN TỰ – SINH VIÊN LÀM VÀ NỘP BÀI" vertex="1">
          <mxGeometry height="40" width="660" x="470" y="20" as="geometry" />
        </mxCell>
