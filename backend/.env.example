# Sao chép file này thành .env rồi sửa thông tin cho đúng máy bạn
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quiz_db

SERVER_PORT=8081
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban

# Tao khoa an toan bang: [Convert]::ToBase64String((1..32 | %% { Get-Random -Maximum 256 }))
# Khong commit khoa nay. Upload bai tap se tu choi neu khoa khong du 32 byte base64.
FILE_ENCRYPTION_KEY=
UPLOAD_DIR=data/uploads

# Gmail SMTP dùng cho OTP kích hoạt và khôi phục mật khẩu.
# Dùng App Password của Gmail, không dùng mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Chạy AutoMigrate (tạo/sửa bảng theo file entity) - bước này CHẬM.
# Đặt true khi vừa sửa internal/entity/entity.go, chạy 1 lần rồi đổi lại false.
AUTO_MIGRATE=false

# debug = in ra toàn bộ route + mọi request (chỉ dùng khi cần soi lỗi)
GIN_MODE=release
